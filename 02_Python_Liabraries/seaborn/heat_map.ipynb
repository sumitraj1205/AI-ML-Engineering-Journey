   "source": [
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "sns.set_theme()\n",
    "a = sns.load_dataset(\"flights\")\n",
    "print(a.head())\n",
    "b = a.pivot(index = \"year\", columns = \"month\", values = \"passengers\")\n",
    "sns.heatmap(\n",
    "    b,\n",
    "    cmap = \"coolwarm\",\n",
    "    annot = True,\n",
    "    fmt = \"d\"\n",
    ")"
   ]
