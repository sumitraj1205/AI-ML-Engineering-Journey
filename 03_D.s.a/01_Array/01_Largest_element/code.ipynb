   "source": [
    "n = int(input(\"Enter the number of elements: \"))\n",
    "\n",
    "arr = list(map(int, input(\"Enter the elements: \").split()))\n",
    "\n",
    "largest = arr[0]\n",
    "\n",
    "for i in range(1, n):\n",
    "    if arr[i] > largest:\n",
    "        largest = arr[i]\n",
    "\n",
    "print(\"Largest element =\", largest)"
   ]
  }
