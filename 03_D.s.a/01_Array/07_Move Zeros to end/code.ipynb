   "source": [
    "def move_zeros(arr):\n",
    "    j = 0\n",
    "\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i] != 0:\n",
    "            arr[j], arr[i] = arr[i], arr[j]\n",
    "            j += 1\n",
    "\n",
    "    return arr\n",
    "\n",
    "\n",
    "arr = [1, 0, 2, 0, 3, 0, 4]\n",
    "\n",
    "print(\"Original array:\", arr)\n",
    "print(\"After moving zeros:\", move_zeros(arr))"
   ]
  }
