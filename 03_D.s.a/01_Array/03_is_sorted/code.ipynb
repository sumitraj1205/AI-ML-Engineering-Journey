   "source": [
    "def is_sorted(arr):\n",
    "    for i in range(len(arr) - 1):\n",
    "        if arr[i] > arr[i + 1]:\n",
    "            return False\n",
    "    return True\n",
    "\n",
    "\n",
    "arr = [1, 2, 3, 4, 5]\n",
    "\n",
    "if is_sorted(arr):\n",
    "    print(\"Array is sorted\")\n",
    "else:\n",
    "    print(\"Array is not sorted\")"
   ]
  }
