   "source": [
    "def find_missing_number(arr):\n",
    "    n = len(arr) + 1\n",
    "\n",
    "    total = n * (n + 1) // 2\n",
    "    array_sum = sum(arr)\n",
    "\n",
    "    return total - array_sum\n",
    "\n",
    "\n",
    "arr = [1, 2, 3, 5]\n",
    "\n",
    "print(\"Missing number:\", find_missing_number(arr))"
   ]
  }
