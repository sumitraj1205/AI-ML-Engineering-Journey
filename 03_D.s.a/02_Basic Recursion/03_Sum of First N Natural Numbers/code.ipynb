   "source": [
    "def sum_n(n):\n",
    "    if n == 0:\n",
    "        return 0\n",
    "\n",
    "    return n + sum_n(n - 1)\n",
    "\n",
    "\n",
    "n = 5\n",
    "\n",
    "print(\"Sum:\", sum_n(n))"
   ]
