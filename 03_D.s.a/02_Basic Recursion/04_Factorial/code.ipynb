   "source": [
    "def factorial(n):\n",
    "    if n == 0 or n == 1:\n",
    "        return 1\n",
    "\n",
    "    return n * factorial(n - 1)\n",
    "\n",
    "\n",
    "n = 5\n",
    "\n",
    "print(\"Factorial:\", factorial(n))"
   ]
  }
