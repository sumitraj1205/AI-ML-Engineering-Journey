   "source": [
    "def fibonacci(n):\n",
    "    if n <= 1:\n",
    "        return n\n",
    "\n",
    "    return fibonacci(n - 1) + fibonacci(n - 2)\n",
    "\n",
    "\n",
    "n = 6\n",
    "\n",
    "print(\"Fibonacci number:\", fibonacci(n))"
   ]
  }
