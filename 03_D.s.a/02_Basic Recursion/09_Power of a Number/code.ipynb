   "source": [
    "def power(base, exponent):\n",
    "    if exponent == 0:\n",
    "        return 1\n",
    "\n",
    "    return base * power(base, exponent - 1)\n",
    "\n",
    "\n",
    "base = 2\n",
    "exponent = 5\n",
    "\n",
    "print(\"Result:\", power(base, exponent))"
   ]
