   "source": [
    "def reverse_array(arr, left, right):\n",
    "    if left >= right:\n",
    "        return\n",
    "\n",
    "    arr[left], arr[right] = arr[right], arr[left]\n",
    "\n",
    "    reverse_array(arr, left + 1, right - 1)\n",
    "\n",
    "\n",
    "arr = [1, 2, 3, 4, 5]\n",
    "\n",
    "reverse_array(arr, 0, len(arr) - 1)\n",
    "\n",
    "print(\"Reversed array:\", arr)"
   ]
  }
