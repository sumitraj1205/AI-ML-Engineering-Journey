    "def print_numbers(n):\n",
    "    if n == 0:\n",
    "        return\n",
    "\n",
    "    print(n)\n",
    "    print_numbers(n - 1)\n",
    "\n",
    "\n",
    "n = 5\n",
    "print_numbers(n)"
