# Problem: Implement Stack using Queue
# Approach: Use one queue and rotate elements after push
# Time Complexity: Push O(n), Pop O(1), Top O(1)
# Space Complexity: O(n)

from collections import deque

class Stack:
    def __init__(self):
        self.q = deque()

    def push(self, x):
        self.q.append(x)

        # Move previous elements behind the new element
        for _ in range(len(self.q) - 1):
            self.q.append(self.q.popleft())

    def pop(self):
        if not self.q:
            return -1
        return self.q.popleft()

    def top(self):
        if not self.q:
            return -1
        return self.q[0]

    def empty(self):
        return len(self.q) == 0

s = Stack()
s.push(10)
s.push(20)
s.push(30)

print(s.pop())  
print(s.top())  